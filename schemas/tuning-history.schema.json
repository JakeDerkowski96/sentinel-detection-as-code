{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-detection-as-code/schemas/tuning-history.schema.json",
  "title": "Tuning history (tuning-history.yaml)",
  "description": "Append-only record of every behavioural change, including rejected ones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DET-[A-Z0-9]+-\\d{4}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "type",
          "summary",
          "origin",
          "outcome"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "type": {
            "enum": [
              "create",
              "tune",
              "fix",
              "retire",
              "reinstate"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "human",
              "agent"
            ]
          },
          "outcome": {
            "enum": [
              "proposed",
              "merged",
              "rejected",
              "rolled-back"
            ]
          },
          "pr": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "findings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "replayReport": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
