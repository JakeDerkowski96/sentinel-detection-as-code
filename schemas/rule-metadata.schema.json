{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-detection-as-code/schemas/rule-metadata.schema.json",
  "title": "Rule metadata (metadata.yaml)",
  "description": "Context ARM has no slot for: lifecycle, ownership, dependencies, targeting, agent controls, documentation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "lifecycle",
    "owner",
    "confidenceTier",
    "created",
    "dataSources",
    "deployment",
    "agent",
    "documentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DET-[A-Z0-9]+-\\d{4}$"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "validated",
        "sandbox-passed",
        "canary",
        "approved",
        "production",
        "retired"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "confidenceTier": {
      "enum": [
        "Experimental",
        "Tuned",
        "Stable"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "package": {
      "type": "string",
      "pattern": "^PKG-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "dataSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tables"
      ],
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "solutions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FUNC-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "parsers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PARSER-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "watchlists": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WL-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "automationRules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AUTO-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "playbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PB-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "workbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WB-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "global",
            "selected",
            "excluded",
            "capability",
            "tenant-specific"
          ]
        },
        "tenants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "solutions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "connectors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "productionCanary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "Informational",
                "Low",
                "Medium",
                "High"
              ]
            },
            "duration": {
              "type": "string",
              "pattern": "^P(?=\\d|T\\d)(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+S)?)?$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "selected",
                  "excluded",
                  "tenant-specific"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tenants"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "capability"
              }
            }
          },
          "then": {
            "required": [
              "requirements"
            ]
          }
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedAlertVolume": {
          "enum": [
            "very-low",
            "low",
            "medium",
            "high"
          ]
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "falsePositiveSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blindSpots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuning",
        "origin"
      ],
      "properties": {
        "tuning": {
          "enum": [
            "allowed",
            "propose-only",
            "locked"
          ]
        },
        "origin": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "analystPlaybook": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.md$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
