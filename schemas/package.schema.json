{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-detection-as-code/schemas/package.schema.json",
  "title": "Package (content/packages/<id>.yaml)",
  "description": "Unit of deployment for a detection family while each resource keeps its own identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "contents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^PKG-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "detections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DET-[A-Z0-9]+-\\d{4}$"
          },
          "uniqueItems": true
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FUNC-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "parsers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PARSER-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "watchlists": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WL-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "automationRules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AUTO-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "playbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PB-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "workbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WB-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3}$"
          },
          "uniqueItems": true
        },
        "huntingQueries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HUNT-[A-Z0-9]+-\\d{4}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
