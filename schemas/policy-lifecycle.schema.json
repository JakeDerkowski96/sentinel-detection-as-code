{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-detection-as-code/schemas/policy-lifecycle.schema.json",
  "title": "Lifecycle policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "states",
    "transitions",
    "human_only_transitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "states": {
      "type": "array",
      "items": {
        "enum": [
          "draft",
          "validated",
          "sandbox-passed",
          "canary",
          "approved",
          "production",
          "retired"
        ]
      },
      "uniqueItems": true
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "draft",
            "validated",
            "sandbox-passed",
            "canary",
            "approved",
            "production",
            "retired"
          ]
        }
      }
    },
    "human_only_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "enum": [
              "draft",
              "validated",
              "sandbox-passed",
              "canary",
              "approved",
              "production",
              "retired"
            ]
          },
          "to": {
            "enum": [
              "draft",
              "validated",
              "sandbox-passed",
              "canary",
              "approved",
              "production",
              "retired"
            ]
          }
        }
      }
    }
  }
}
