{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-detection-as-code/schemas/exceptions.schema.json",
  "title": "Approved exceptions (exceptions.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DET-[A-Z0-9]+-\\d{4}$"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "reason",
          "owner",
          "approvedBy",
          "approvedOn",
          "expires",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EXC-\\d{3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "approvedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "implementation": {
            "enum": [
              "kql-exclusion",
              "watchlist",
              "suppression"
            ]
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
